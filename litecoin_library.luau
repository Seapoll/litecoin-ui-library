 function c.Set(v) v=math.clamp(math.floor(tonumber(v) or 0),0,100) api.State[id]=v number.Text=tostring(v) fill.BackgroundColor3=Blue knob.BackgroundColor3=Blue fill.Size=UDim2.new(v/100,0,1,0) knob.Position=UDim2.new(v/100,0,0,-4) if callback then callback(v) end end
 function c.At(x) if b.AbsoluteSize.X>0 then c.Set((x-b.AbsolutePosition.X)/b.AbsoluteSize.X*100+0.5) end end
 on(b.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingSlider={Control=c,Input=i} c.At(i.Position.X) end end)
 c.Set(initial) api.Controls[id]=c return c
end
