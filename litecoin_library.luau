local function toggle(parent,id,name,y,initial,callback)
 label(parent,id.."Label",name,16,y,180,30,13)
 local b=button(parent,id,"",parent.Size.X.Offset-35,y+6,18,18,false)
 b.UICorner.CornerRadius=UDim.new(0,4)
 local border=make("UIStroke",{Color=Color3.fromRGB(211,217,226),Thickness=0.8,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},b)
 local check=make("ImageLabel",{Name="Check",Position=UDim2.fromOffset(2,2),Size=UDim2.fromOffset(14,14),BackgroundTransparency=1,Image=tickAsset,ImageColor3=White,ScaleType=Enum.ScaleType.Fit},b)
 local badge=button(parent,id.."Key","None",parent.Size.X.Offset-102,y+3,61,24)
 badge.TextSize=11 make("UIStroke",{Color=Line,Thickness=1},badge)
 local c={Button=b,KeyButton=badge,Key=nil,Mode="Toggle",Check=check}
 function c.Set(v)
  api.State[id]=not not v
  animate(b,{BackgroundColor3=v and Color3.fromRGB(53,94,155) or Color3.fromRGB(233,237,243)})
  animate(border,{Color=v and Color3.fromRGB(53,94,155) or Color3.fromRGB(211,217,226)})
  check.Visible=not not v
  if callback then callback(not not v) end
 end
 function c.RefreshBinding()
  badge.Text=c.Key and c.Key.Name or "None"
  badge:SetAttribute("Mode",c.Mode) badge:SetAttribute("BoundKey",c.Key and c.Key.Name or "")
 end
 function c.Bind(key)
  assert(key==nil or (typeof(key)=="EnumItem" and key.EnumType==Enum.KeyCode and key~=Enum.KeyCode.Unknown),"Expected keyboard KeyCode")
  releaseHeld(c) c.Key=key c.RefreshBinding()
 end
 function c.SetMode(mode) assert(mode=="Hold" or mode=="Toggle") releaseHeld(c) c.Mode=mode c.RefreshBinding() end
 function c.Capture() cancelCapture() pendingBind=c badge.Text="Press key" setBindingMenu(false) end
 function c.OpenMenu()
  cancelCapture() menuOwner=c
  bindMenu.Position=UDim2.fromOffset(badge.AbsolutePosition.X, badge.AbsolutePosition.Y+badge.AbsoluteSize.Y+4)
  for mode,option in pairs(bindOptions) do option.Text=(mode==c.Mode and "• " or "")..mode end
  setBindingMenu(true)
 end
 on(badge.MouseButton1Click,c.Capture)
 on(badge.MouseButton2Click,c.OpenMenu) on(b.MouseButton2Click,c.OpenMenu)
 bindings[id]=c c.RefreshBinding()
 c.Set(initial) on(b.MouseButton1Click,function() c.Set(not api.State[id]) end)
 api.Controls[id]=c return c
end
for mode,b in pairs(bindOptions) do on(b.MouseButton1Click,function()
 if menuOwner then if mode=="Unbind" then menuOwner.Bind(nil) else menuOwner.SetMode(mode) end end setBindingMenu(false)
end) end
api.Bindings=bindings api.BindingMenu=bindMenu api.BindingOptions=bindOptions
function api.DismissBindingAt(x,y)
 if not menuOpen then return false end
 local p,s=bindMenu.AbsolutePosition,bindMenu.AbsoluteSize
 if x<p.X or y<p.Y or x>=p.X+s.X or y>=p.Y+s.Y then
  setBindingMenu(false)
  return true
 end
 return false
end
on(UIS.InputBegan,function(i)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.MouseButton2 or i.UserInputType==Enum.UserInputType.Touch then
  api.DismissBindingAt(i.Position.X,i.Position.Y)
 end
end)
function api.KeyDown(key,processed,focused)
 if heldKeys[key] then return true end heldKeys[key]=true
 if pendingBind then local c=pendingBind pendingBind=nil c.Bind(key) return true end
 -- Explicit bindings may share Roblox shortcuts; typing in a text box takes priority.
 if focused then return false end
 local used=false
 for _,c in pairs(bindings) do if c.Key==key then
  used=true
  if c.Mode=="Hold" then c.HeldKey=key c.Set(true) else c.Set(not api.State[c.Button.Name]) end
 end end
 return used
end
function api.KeyUp(key)
 heldKeys[key]=nil
 for _,c in pairs(bindings) do if c.HeldKey==key then releaseHeld(c) end end
end
local function releaseAll() heldKeys={} for _,c in pairs(bindings) do releaseHeld(c) end end
on(UIS.WindowFocusReleased,function() releaseAll() cancelCapture() setBindingMenu(false) end)
