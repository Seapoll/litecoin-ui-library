local generation=0
function api.SelectTab(name,instant)
 assert(pages[name],"Unknown tab") closeDropdown() setBindingMenu(false) cancelCapture() generation+=1 local token=generation
 local previous=pages[api.State.Tab] local nextPage=pages[name] api.State.Tab=name
 refreshTabs()
 for _,p in pairs(pages) do if tweens[p] then tweens[p]:Cancel() end end
 if instant or not api.State.Animations or previous==nextPage or not previous then
  for n,p in pairs(pages) do p.Visible=n==name p.GroupTransparency=0 end return
 end
 animate(previous,{GroupTransparency=1},Config.Transition/2)
 task.delay(Config.Transition/2,function()
  if dead or generation~=token then return end
  for n,p in pairs(pages) do p.Visible=n==name end
  nextPage.GroupTransparency=1 animate(nextPage,{GroupTransparency=0},Config.Transition/2)
 end)
end
local drag
on(title.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag={Input=i,Start=i.Position,Position=root.Position} end end)
on(UIS.InputChanged,function(i)
 local mouse=i.UserInputType==Enum.UserInputType.MouseMovement
 if draggingSlider and (mouse or i==draggingSlider.Input) then draggingSlider.Control.At(i.Position.X) end
 if drag and (mouse or i==drag.Input) then local d=i.Position-drag.Start local camera=workspace.CurrentCamera local v=camera and camera.ViewportSize or Vector2.new(1920,1080) local s=root.AbsoluteSize local start=Vector2.new(drag.Position.X.Scale*v.X+drag.Position.X.Offset,drag.Position.Y.Scale*v.Y+drag.Position.Y.Offset) root.Position=UDim2.fromOffset(math.clamp(start.X+d.X,s.X/2,v.X-s.X/2),math.clamp(start.Y+d.Y,s.Y/2,v.Y-s.Y/2)) closeDropdown() end
end)
on(UIS.InputEnded,function(i)
 if i.UserInputType==Enum.UserInputType.Keyboard then api.KeyUp(i.KeyCode) end
 if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingSlider=nil drag=nil return end
 if draggingSlider and i==draggingSlider.Input then draggingSlider=nil end
 if drag and i==drag.Input then drag=nil end
end)
on(UIS.InputBegan,function(i,processed)
 if i.UserInputType~=Enum.UserInputType.Keyboard or i.KeyCode==Enum.KeyCode.Unknown then return end
 local focused=UIS:GetFocusedTextBox()~=nil
 local used=api.KeyDown(i.KeyCode,processed,focused)
 if used or processed or focused then return end
 if i.KeyCode==Config.ToggleKey then root.Visible=not root.Visible closeDropdown() setBindingMenu(false) cancelCapture() end
 if i.KeyCode==Enum.KeyCode.Escape then closeDropdown() setBindingMenu(false) end
end)
