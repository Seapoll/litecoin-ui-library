local serial=0
local function identifier(opts)
 serial+=1
 local id=opts.Id or ("Control_"..serial)
 assert(type(id)=="string" and id~="" and id~="Tab" and id~="Animations","Id must be a nonempty string; Tab and Animations are reserved")
 assert(not api.Controls[id],"Duplicate control Id: "..id)
 return id
end
local function dispatch(callback,...)
 if not callback or dead then return end
 assert(type(callback)=="function","Callback must be a function")
 local args=table.pack(...)
 task.spawn(function()
  local ok,err=pcall(callback,table.unpack(args,1,args.n))
  if not ok then api.LastError=tostring(err) warn("[Litecoin UI] "..tostring(err)) end
 end)
end
local function expose(raw,id,options)
 local handle={Instance=raw.Button or raw.Input or raw.Instance,Raw=raw,Id=id}
 function handle:Get() return api.State[id] end
 function handle:Set(v,silent) raw.Set(v,silent) return self end
 if raw.Bind then
  function handle:SetKey(key) raw.Bind(key) return self end
  function handle:SetMode(mode) raw.SetMode(mode) return self end
  function handle:GetKey() return raw.Key end
  function handle:GetMode() return raw.Mode end
 end
 return handle
end
function api:Page(options)
 assert(not dead,"Window was destroyed")
 options=options or {}
 local name=options.Name or ("Page "..tostring(#pageOrder+1))
 assert(type(name)=="string" and name~="","Page Name must be a nonempty string")
 assert(not pages[name],"Duplicate page name: "..name)
 local view=frame(content,name,0,0,770,450,nil,nil,"CanvasGroup")
 view.Visible=false pages[name]=view table.insert(pageOrder,name)
 local page={Name=name,Instance=view,Sections={}}
 local columns={}
 for i,side in ipairs({"Left","Right"}) do
  local background=frame(view,side.."Panel",(i-1)*390,0,380,450,White,8)
  local column=make("ScrollingFrame",{Name=side.."Sections",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y},background)
  make("UIPadding",{PaddingTop=UDim.new(0,12),PaddingBottom=UDim.new(0,12),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)},column)
  make("UIListLayout",{Padding=UDim.new(0,14),SortOrder=Enum.SortOrder.LayoutOrder},column)
  columns[side]=column
 end
 local navButton=button(nav,"Tab_"..name,name,0,0,0,32,false)
 navButton.TextSize=15 navButton.TextTruncate=Enum.TextTruncate.None
 navButton.LayoutOrder=#pageOrder navButton.AutomaticSize=Enum.AutomaticSize.X
 make("UIPadding",{PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14)},navButton)
 corners(navButton,11) tabButtons[name]=navButton page.NavButton=navButton
 on(navButton.MouseEnter,function() hoveredTab=name refreshTabs() end)
 on(navButton.MouseLeave,function() if hoveredTab==name then hoveredTab=nil end refreshTabs() end)
 on(navButton.MouseButton1Click,function() api.SelectTab(name) end)
 function page:Select() api.SelectTab(name) return self end
 function page:Section(opts)
  assert(not dead,"Window was destroyed") opts=opts or {}
  local side=opts.Side or "Left" assert(columns[side],"Side must be Left or Right")
  local f=section(columns[side],opts.Name or "Section",0,0,356,60,opts.Description)
  f.LayoutOrder=#self.Sections+1
  local s={Instance=f,Cursor=opts.Description and 68 or 44}
  local function row(height)
   assert(not dead,"Window was destroyed") local y=s.Cursor s.Cursor+=height+8 f.Size=UDim2.fromOffset(356,s.Cursor+8) return y
  end
  function s:Toggle(o)
   o=o or {} local id=identifier(o)
   local raw=toggle(f,id,o.Name or "Toggle",row(30),o.Default==true,nil)
   local set=raw.Set
   function raw.Set(v,silent)
    local previous=api.State[id] set(v)
    if not silent and previous~=api.State[id] then dispatch(o.Callback,api.State[id]) end
   end
   raw.Bind(o.Keybind) raw.SetMode(o.Mode or "Toggle")
   return expose(raw,id,o)
  end
  function s:Slider(o)
   o=o or {} local id=identifier(o)
   local min,max,step=o.Min or 0,o.Max or 100,o.Step or 1
   assert(max>min and step>0,"Slider requires Max > Min and Step > 0")
   local raw=slider(f,id,o.Name or "Slider",row(52),0,nil)
   local number=f:FindFirstChild(id.."Value")
   local fill,knob=raw.Button.Rail.Fill,raw.Button.Rail.Knob
   function raw.Set(v,silent)
    assert(type(v)=="number" and v==v and math.abs(v)<math.huge,"Slider expects a finite number")
    v=math.clamp(min+math.floor((v-min)/step+0.5)*step,min,max)
    v=tonumber(string.format("%.8f",v))
    local previous=api.State[id] api.State[id]=v number.Text=tostring(v)
    local a=(v-min)/(max-min) fill.Size=UDim2.new(a,0,1,0) knob.Position=UDim2.new(a,0,0,-4)
    if not silent and previous~=v then dispatch(o.Callback,v) end
   end
   function raw.At(x) if raw.Button.AbsoluteSize.X>0 then raw.Set(min+math.clamp((x-raw.Button.AbsolutePosition.X)/raw.Button.AbsoluteSize.X,0,1)*(max-min)) end end
   raw.Set(o.Default or min,true)
   return expose(raw,id,o)
  end
  function s:Dropdown(o)
   o=o or {} local id=identifier(o)
   assert(type(o.Options)=="table" and #o.Options>0,"Dropdown needs Options")
   for _,v in ipairs(o.Options) do assert(type(v)=="string","Dropdown options must be strings") end
   local raw=dropdown(f,id,o.Name or "Dropdown",row(60),table.clone(o.Options),o.Default or o.Options[1],nil)
   local set=raw.Set
   function raw.Set(v,silent) local previous=api.State[id] set(v) if not silent and previous~=v then dispatch(o.Callback,v) end end
   return expose(raw,id,o)
  end
  function s:Button(o)
   o=o or {} local id=identifier(o)
   local b=button(f,id,o.Name or "Button",16,row(34),324,34)
   local raw={Button=b} api.Controls[id]=raw
   on(b.MouseButton1Click,function() dispatch(o.Callback) end)
   return {Instance=b,Id=id,Fire=function() dispatch(o.Callback) end}
  end
  function s:Textbox(o)
   o=o or {} local id=identifier(o) local y=row(61)
   label(f,id.."Label",o.Name or "Text",16,y,324,22,13)
   local input=make("TextBox",{Name=id,Position=UDim2.fromOffset(16,y+25),Size=UDim2.fromOffset(324,32),BackgroundColor3=White,BorderSizePixel=0,Text=tostring(o.Default or ""),PlaceholderText=o.Placeholder or "Type here…",PlaceholderColor3=Muted,TextColor3=Black,TextSize=13,FontFace=font,ClearTextOnFocus=false},f)
   corners(input,7) make("UIStroke",{Thickness=0.8,Color=Line},input)
   make("UIPadding",{PaddingLeft=UDim.new(0,10)},input)
   local raw={Input=input}
   function raw.Set(v,silent) v=tostring(v) local previous=api.State[id] input.Text=v api.State[id]=v if not silent and previous~=v then dispatch(o.Callback,v) end end
   raw.Set(o.Default or "",true)
   on(input.FocusLost,function(enter) local v=input.Text api.State[id]=v dispatch(o.Callback,v,enter) end)
   api.Controls[id]=raw return expose(raw,id,o)
  end
  function s:Label(o)
   if type(o)=="string" then o={Text=o} end o=o or {}
   local height=o.Height or 28
   local t=label(f,"Label",o.Text or o.Name or "Label",16,row(height),324,height,o.Size or 13,Muted)
   t.TextWrapped=true
   return {Instance=t,Set=function(_,value) t.Text=tostring(value) end}
  end
  s.TextBox=s.Textbox
  table.insert(self.Sections,s)
  return s
 end
 for _,method in ipairs({"Toggle","Slider","Dropdown","Button","Textbox","TextBox","Label"}) do
  page[method]=function(self,opts)
   if not self.DefaultSection then self.DefaultSection=self:Section({Name=name}) end
   return self.DefaultSection[method](self.DefaultSection,opts)
  end
 end
 api.PageObjects[name]=page
 if not api.State.Tab then api.SelectTab(name,true) end
 return page
