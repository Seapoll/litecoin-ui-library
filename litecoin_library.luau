local function setBindingMenu(open)
 if menuOpen==open then return end
 menuOpen=open menuGeneration+=1 local token=menuGeneration
 if open then
  if not bindMenu.Visible then bindMenu.GroupTransparency=1 menuScale.Scale=0.97 end
  bindMenu.Visible=true
